# ENV.example — SolarPro Template

# No environment variables are required for local development or static export.
# Add any third-party API keys or CMS tokens here when integrating external services.

# Example: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Example: Contact form backend
# CONTACT_FORM_API_KEY=your_key_here
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact
