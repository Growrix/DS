{
  "name": "optilux",
  "version": "0.1.0",
  "category": "local-business",
  "slug": "optilux",
  "description": "Screenshot-first eye care local business template",
  "stack": "nextjs",
  "nextjs_version": "16.2.6",
  "react_version": "19.2.4",
  "tailwind_version": "4",
  "typescript": true,
  "app_router": true,
  "foundation_attached": false,
  "attach_mode": "standalone_template",
  "execution_profile": "replica_strict",
  "screenshot_source_of_truth": true,
  "allow_os_ui_overrides": false,
  "dev_port": 3001,
  "pages": [
    "/",
    "/index-2",
    "/index-3",
    "/index-4",
    "/index-5",
    "/about",
    "/services",
    "/services-2",
    "/service-single",
    "/our-doctors",
    "/pricing",
    "/testimonials",
    "/faq",
    "/shop",
    "/shop/product-single",
    "/blog",
    "/blog/[slug]",
    "/contact"
  ],
  "images": "free_stock_placeholders",
  "brand_replaced": true,
  "replacement_brand": "OptiLux",
  "footer_attribution": "Built with OptiLux Template"
}
