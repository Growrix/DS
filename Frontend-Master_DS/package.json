{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "ds:audit": "node scripts/ds-audit.mjs",
    "ds:a11y": "jest --runInBand src/ds/components/__tests__/keyboard.a11y.test.tsx src/ds/components/__tests__/keyboard-extended.a11y.test.tsx src/ds/runtime/app/mobile/__tests__/Sheet.test.tsx",
    "ds:contract": "jest --runInBand --testPathPatterns=ds-contract.gen.test",
    "ds:font-audit": "node scripts/ds-font-audit.mjs",
    "ds:coverage": "node scripts/ds-coverage.mjs",
    "ds:seo-check": "node scripts/ds-seo-check.mjs",
    "ds:perf-budget": "node scripts/ds-perf-budget.mjs",
    "ds:lh": "npx -y @lhci/cli@latest autorun",
    "ds:visual": "npx -y playwright@latest test --config=playwright.config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run ds:audit && npm run ds:a11y && npm run ds:contract && npm run ds:font-audit && npm run ds:perf-budget"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
