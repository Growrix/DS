  "safety": {
    "version": "1.0",
    "topLevelRule": "This design system is the FACTORY, not the deliverable. Per-client sites are exported. Agents may ADD project content via presets; they MUST NOT EDIT the DS core. Violating this contract breaks every site that consumes the DS.",
    "discoveryFiles": {
      "humanContract": "AI-AGENT-CONTRACT.md",
      "machineContract": "generated/ds.contract.json",
      "registry": "src/ds/composition/sections/_registry.ts",
      "schema": "src/ds/composition/sections/_schema.ts",
      "presetTypes": "src/ds/platform/publicSitePreset.ts"
    },
    "lockedGlobs": [
      "src/ds/foundation/**",
      "src/ds/primitives/**",
      "src/ds/components/**",
      "src/ds/composition/sections/_schema.ts",
      "src/ds/composition/sections/_helpers.ts",
      "src/ds/composition/patterns/**",
      "src/ds/composition/templates/**",
      "src/ds/composition/blocks/**",
      "src/ds/layouts/**",
      "src/ds/platform/PublicPresetPage.tsx",
      "src/ds/platform/PublicSiteShell.tsx",
      "src/ds/platform/PublicSiteHeader.tsx",
      "src/ds/platform/PublicSiteFooter.tsx",
      "src/ds/platform/SupportDock.tsx",
      "src/ds/platform/publicSitePreset.ts",
      "src/ds/platform/siteConfig.ts",
      "src/ds/runtime/**",
      "src/ds/visuals/**",
      "src/ds/widgets/**",
      "src/ds/styles/**",
      "src/ds/preview/**",
      "src/ds/icons.ts",
      "src/ds/patterns/**",
      "src/ds/utils/**",
      "src/ds/index.ts",
      "src/ds/__codegen__/**",
      "DOC/**",
      "AI-AGENT-CONTRACT.md",
      ".ai-scope.json",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "next.config.ts",
      "next-env.d.ts",
      "eslint.config.mjs",
      "jest.config.js",
      "jest.setup.ts",
      "scripts/**"
    ],
    "extensibleGlobs": [
      "src/ds/composition/sections/variants/**/*.tsx",
      "src/ds/composition/templates/wireframes/page-*.ts",
      "src/site/presets/*.ts"
    ],
    "projectContentGlobs": [
      "src/app/**",
      "src/features/**",
      "src/flows/**"
    ],
    "forbiddenActions": [
      "Modifying any file matching fileScopes.locked.globs",
      "Adding new top-level dependencies without explicit human approval",
      "Removing or renaming registered variants (variantIds are a public contract)",
      "Removing or renaming registered wireframes (wireframe ids are a public contract)",
      "Introducing raw hex / rgb / px / ms values outside ds.tokens.css (caught by ds:audit)",
      "Editing the SECTION_REGISTRY map for any reason other than adding a single new entry",
      "Editing the WIREFRAME_REGISTRY map for any reason other than adding a single new entry",
      "Introducing motion not declared as a motion preset",
      "Declaring a variant effect outside the variant's archetype permission window (caught by ds:contract permission scan)",
      "Cross-archetype mixing inside a wireframe (every section.variantId MUST share the wireframe's archetype; caught by ds:contract validation)",
      "Inventing variant ids or wireframe ids at runtime (consumers MUST select from the live registry)",
      "Editing files inside DOC/ (the design-system handbook is human-curated)"
    ],
    "allowedActions": [
      "Reading any file in the repo for context",
      "Adding new variant files under src/ds/composition/sections/variants/<kind>/",
      "Adding new wireframe files under src/ds/composition/templates/wireframes/page-*.ts",
      "Adding new preset files under src/site/presets/",
      "Editing src/app/** route content + per-project pages (including preview routes under src/app/preview/**)",
      "Editing per-project flows under src/flows/**",
      "Running npm run ds:contract, ds:audit, ds:a11y, verify"
    ],
    "verificationGate": {
      "command": "npm run verify",
      "chain": [
        "typecheck",
        "lint",
        "test",
        "build",
        "ds:audit",
        "ds:a11y",
        "ds:contract"
      ],
      "rule": "An agent MUST run `npm run verify` before claiming an extension is complete. Any non-zero exit fails the extension."
    }
  },
  "validation": {
    "permissionViolations": [],
    "wireframeViolations": [],
    "ok": true
  }
}
