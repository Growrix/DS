      "label-lg": "0.9375rem",
      "label-md": "0.875rem",
      "caption": "0.75rem"
    },
    "lineHeight": {
      "display-1": "1.08",
      "display-2": "1.08",
      "display-3": "1.1",
      "h1": "1.15",
      "h2": "1.2",
      "h3": "1.24",
      "h4": "1.28",
      "h5": "1.32",
      "body-lg": "1.6",
      "body-md": "1.6",
      "body-sm": "1.55",
      "label-lg": "1.45",
      "label-md": "1.45",
      "caption": "1.4"
    },
    "letterSpacing": {
      "display": "-0.03em",
      "heading": "-0.02em",
      "body": "0em",
      "overline": "0.08em"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "display": 800
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "30": 120
  },
  "sectionY": {
    "mobile": 40,
    "tablet": 56,
    "desktop": 80
  },
  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "full": 9999
  },
  "shadow": {
    "1": "0 10px 24px rgba(16, 34, 53, 0.08)",
    "2": "0 18px 40px rgba(16, 34, 53, 0.14)",
    "3": "0 32px 80px rgba(9, 19, 29, 0.22)",
    "focus": "0 0 0 2px rgba(31, 122, 224, 0.26)"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "320ms",
      "cinematic": "460ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "spring": "cubic-bezier(0.16, 1, 0.3, 1)",
      "decel": "cubic-bezier(0.12, 0.84, 0.32, 1)",
      "accel": "cubic-bezier(0.55, 0, 0.9, 0.2)"
    }
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1440
  },
  "container": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1200,
    "2xl": 1360
  },
  "zIndex": {
    "base": 0,
    "content": 10,
    "sticky": 20,
    "overlay": 40,
    "modal": 50,
    "toast": 60
  },
  "icon": {
    "size": {
      "xs": 16,
      "sm": 20,
      "md": 24,
      "lg": 32
    },
    "stroke": {
      "thin": 1.5,
      "base": 1.75,
      "bold": 2
    }
  },
  "custom": {
    "surface-stack": {
      "hero-overlay": "dark-gradient-panel",
      "trust-strip": "inset-panel",
      "cta-band": "primary-surface"
    },
    "content-density": {
      "spacious": "hero-and-cta",
      "balanced": "services-proof-and-reviews",
      "dense": "footer-and-faq"
    }
  }
}
